<Project>
  <!-- This makes sure the outer Directory.Build.props file in the root of the solution is read and applied -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <!-- Common properties for all fixture projects -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <!-- CS9113 warns about unused parameters - almost all parameters will be unused in this fake project -->
    <NoWarn>$(NoWarn);CS9113</NoWarn>
  </PropertyGroup>

  <!-- Exclude fixture projects from code coverage -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
  </ItemGroup>

  <!-- Make internals visible to the all test project(s) -->
  <ItemGroup>
    <InternalsVisibleTo Include="ZCrew.Extensions.DependencyInjection.UnitTests"/>
    <InternalsVisibleTo Include="ZCrew.Extensions.DependencyInjection.IntegrationTests"/>

    <InternalsVisibleTo Include="ZCrew.Extensions.DependencyInjection.Registration.UnitTests"/>
    <InternalsVisibleTo Include="ZCrew.Extensions.DependencyInjection.Registration.IntegrationTests"/>
  </ItemGroup>
</Project>
