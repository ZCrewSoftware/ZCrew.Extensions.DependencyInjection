<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RegistrationSample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <!--
    Local project references until the v3 NuGet package (which bundles the [Service] source generator as an
    analyzer) is published. Once it is, both references below can be replaced with a single package reference:
      <PackageReference Include="ZCrew.Extensions.DependencyInjection.Registration" Version="..." />
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ZCrew.Extensions.DependencyInjection.Registration\ZCrew.Extensions.DependencyInjection.Registration.csproj" />
    <ProjectReference Include="..\..\..\src\ZCrew.Extensions.DependencyInjection.Generator\ZCrew.Extensions.DependencyInjection.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
