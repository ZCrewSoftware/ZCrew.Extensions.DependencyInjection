<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RegistrationSample</RootNamespace>
  </PropertyGroup>

  <!-- The [Service] source generator ships inside this package as an analyzer, so nothing else is needed -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="ZCrew.Extensions.DependencyInjection.Registration" Version="3.0.0" />
  </ItemGroup>
</Project>
